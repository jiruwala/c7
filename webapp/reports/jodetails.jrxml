	<queryString>
		<![CDATA[SELECT pur2.ord_refer REFER,pur2.ord_no INVOICE_NO,pur2.ord_pos ITEMPOS,pur2.stra,
items.DESCR descr2,pur2.descr, items.PACKD, (pur2.ord_allqty) allqty, pur2.ord_price-pur2.ord_discamt pur_PRICE, pur2.ord_pack pack,
((pur2.ord_price-pur2.ord_discamt)*pur2.ord_allqty/pur2.ord_pack) AMOUNT,(ord_allqty/pur2.ord_PACK) PKX,
pur2.ITEM_COLOR, pur2.ITEM_SIZE, pur2.ADD_WORK, pur2.RECTO_VERSO, pur2.SRNO, pur2.PAGES, pur2.SECTION, pur2.MACHINE, pur2.MATERIAL
FROM pord2 pur2,items
WHERE pur2.ord_code=601
 and pur2.keyfld=$P{KEYFLD}
 and items.reference=pur2.ord_refer
ORDER BY pur2.ord_pos]]>
	</queryString>
