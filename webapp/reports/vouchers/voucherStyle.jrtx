<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio -->
<jasperTemplate xmlns="http://jasperreports.sourceforge.net/jasperreports/template" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/template http://jasperreports.sourceforge.net/xsd/jaspertemplate.xsd">
	<style name="strColHeader" fontName="Times New Roman" fontSize="12" isBold="false" isUnderline="false"/>
	<style name="strDetails" vTextAlign="Middle" vImageAlign="Middle" fontName="SansSerif" fontSize="10"/>
	<style name="strSummary" fontName="Times New Roman" fontSize="12"/>
	<style name="strTitle" forecolor="#006666" hTextAlign="Center" hImageAlign="Center" vTextAlign="Middle" vImageAlign="Middle" fontName="Times New Roman" fontSize="18" isBold="true" isUnderline="false"/>
	<style name="strCompanyName" forecolor="#006666" hTextAlign="Left" hImageAlign="Left" vTextAlign="Middle" vImageAlign="Middle" fontName="DejaVu Serif" fontSize="24" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
	<style name="strCompanySpec" forecolor="#006666" backcolor="#FFFFFF" fill="Solid" fontName="DejaVu Serif" fontSize="12" isBold="true"/>
	<style name="numQtyRight" hTextAlign="Right" hImageAlign="Right" vTextAlign="Middle" vImageAlign="Middle" fontName="Times New Roman" fontSize="10" isBold="false"/>
	<style name="numQtyCenter" hTextAlign="Center" hImageAlign="Center" vTextAlign="Middle" vImageAlign="Middle" pattern="###0.##;-###0.##" fontName="Times New Roman" fontSize="10"/>
	<style name="numMoney" hTextAlign="Right" hImageAlign="Right" vTextAlign="Middle" vImageAlign="Middle" pattern="#,##0.000;-#,##0.000" fontName="Times New Roman" fontSize="10"/>
	<style name="frameColHeader" fill="Solid">
		<box>
			<topPen lineWidth="1.25"/>
			<bottomPen lineWidth="1.25"/>
		</box>
	</style>
	<style name="frameDetails">
		<box>
			<bottomPen lineWidth="0.75"/>
		</box>
	</style>
	<style name="frameSummary">
		<box>
			<topPen lineWidth="0.75"/>
		</box>
	</style>
	<style name="strHeader" isBlankWhenNull="true" fontName="Times New Roman" fontSize="10" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
	<style name="labelHeader" hTextAlign="Left" hImageAlign="Left" fontName="Times New Roman" fontSize="12" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
	<style name="headerColored" mode="Opaque" backcolor="#FFFFCC"/>
	<style name="field" fontName="DejaVu Sans">
		<box topPadding="2" leftPadding="3">
			<pen lineWidth="0.25"/>
			<topPen lineWidth="0.25"/>
			<leftPen lineWidth="0.25"/>
			<bottomPen lineWidth="0.25"/>
			<rightPen lineWidth="0.25"/>
		</box>
	</style>
</jasperTemplate>
