	<queryString>
		<![CDATA[SELECT ALL ORDER1.ORD_NO, ORDER1.KEYFLD,ORDER1.TQTY, items.descr,
ORDER1.ORD_CODE, ORDER1.ORD_REF, ORDER1.ORD_REFNM, ORDER1.ORD_DATE, 
ORDER1.ORD_SHIP, ORDER1.ORD_SHPDT, ORDER1.ORD_AMT, ORDER1.ORD_DISCAMT, 
ORDER1.ORD_FLAG, ORDER1.ORD_EMPNO, ORDER1.YEAR, ORDER1.REMARKS, ORDER1.PAYTERM, 
ORDER1.VALIDATIY, ORDER1.ATTN, ORDER1.SALEINV,  CBRANCH.B_NAME,CBRANCH.BLOCK, 
CBRANCH.STREET, CBRANCH.JEDDA, CBRANCH.AREA, CBRANCH.TEL,
(SELECT POWER FROM ITEMS WHERE REFERENCE=ORDER1.ORD_SHIP) WGHT,
(SELECT PARTNO FROM ITEMS WHERE REFERENCE=ORDER1.ORD_SHIP) TYPEOFCEM,
CBRANCH.QASIMA,
to_char(TMPLANTLEAVE,'HH24:MI') TMPLANTLEAVE,
(select max(name) from salesp where no=order1.ord_empno) driv_name,
(select max(descr) from items where reference=order1.chem_refer) chem_name,
(select max(vehicleno) from salesp where no=order1.ord_empno) truckno
FROM C_ORDER1 ORDER1, CBRANCH,items
WHERE CBRANCH.CODE=ORDER1.ORD_REF AND ORD_DISCAMT=BRNO
	and "ORDER1"."ORD_NO" >= $P{pfromno} 
	 AND "ORDER1"."ORD_NO" <= $P{ptono} 
	 AND "ORDER1"."ORD_CODE" = 9
	 and items.reference=order1.ord_ship	 
ORDER BY "ORDER1"."ORD_NO" DESC]]>
	</queryString>
