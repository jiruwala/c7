	<queryString>
		<![CDATA[SELECT ALL PUR2.REFER,INVOICE_NO,items.partno,items.power,
ITEMS.DESCR, PUR2.PACKD, sum(PUR2.ALLQTY) allqty, PUR2.PRICE,PUR2.PACK,
SUM((PUR2.PRICE)*PUR2.ALLQTY/PUR2.PACK) AMOUNT,SUM(ALLQTY/PUR2.PACK) PKX
FROM pur2, ITEMS
WHERE PUR2.INVOICE_CODE=21
 AND  (ITEMS.REFERENCE=PUR2.REFER)
 and pur2.keyfld= $P{KEYFLD} 
 GROUP BY PUR2.REFER,INVOICE_NO,items.partno,items.power,PUR2.PRICE,pur2.pack,items.descr,pur2.packd]]>
	</queryString>
