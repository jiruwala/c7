	<queryString>
		<![CDATA[SELECT ALL o.keyfld,o.ord_no INVOICE_NO, o.ord_date INVOICE_DATE,
o.ord_empno,o.remarks memo,o.ord_ref c_cus_no, o.ord_reference,
o.ord_ref INV_REF, o.ord_refnm INV_REFNM, o.STRA, 0 DISC_AMT,1 TYPE,0 DEPTNO,o.ord_discamt c_branch_no,
o.ord_amt inv_amt ,0 add_amt,0 net_amt,
(
  select b_name
  from cbranch where code=o.ord_ref and brno=o.ord_discamt) addr

,F_WORDS(((select nvl(sum(sale_price*(tqty/ord_pack)),0) from c_order1 o2 where o2.keyfld=o.keyfld))) WRDS,
(select nvl(sum(sale_price*(tqty/ord_pack)),0) from c_order1 o2 where o2.keyfld=o.keyfld) inv_amt2,
(select max(name) from salesp where no=o.ord_empno) sls_name,
(select nvl(sum((tqty/ord_pack)),0) from c_order1 o2 where o2.keyfld=o.keyfld) sum_pack_qty,
(SELECT MAX(NAME) FROM STORE WHERE NO=o.STRA) STRANAME,
o.STRB,
location_code,
(select name from locations where code=o.location_code) location_name

FROM  order1 o 
WHERE o.ord_code=11 AND ((o.ord_no>= $P{pfromno} 
AND o.ord_no<= $P{ptono}  
and o.location_code=$P{plocation}) or o.keyfld=$P{pac} )]]>
	</queryString>
