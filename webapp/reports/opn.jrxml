	<queryString>
		<![CDATA[SELECT ALL pur1.keyfld,PUR1.INVOICE_NO, PUR1.INVOICE_DATE, 
DECODE(TYPE,1,'CREDIT',2,'CASH',3,'CHEQUE',4,'K-NET') TYPEE,CTG,
PUR1.SLSMN, lpno,duedate,PUR1.memo,c_cus_no,pur1.reference_information,
PUR1.INV_REF, PUR1.INV_REFNM, PUR1.STRA, PUR1.DISC_AMT,TYPE,DEPTNO,c_branch_no,
pur1.inv_amt ,pur1.deptno add_amt,(pur1.inv_amt+pur1.deptno)-pur1.disc_amt net_amt,
( 
	select max(name) from invoice_codes where code=pur1.type
) type_descr,
(
  select b_name
  from cbranch where code=pur1.c_cus_no and brno=pur1.c_branch_no) addr

,F_WORDS(((select nvl(sum(price*(allqty/pack)),0) from pur2 where pur2.keyfld=pur1.keyfld)+pur1.deptno)-pur1.disc_amt) WRDS,
(select nvl(sum(price*(allqty/pack)),0) from pur2 where pur2.keyfld=pur1.keyfld) inv_amt2,
(select max(name) from salesp where no=slsmn) sls_name,
(select max(ord_no) from pord1 where keyfld=po_keyfld) sono,
(select nvl(sum((allqty/pack)),0) from pur2 where pur2.keyfld=pur1.keyfld) sum_pack_qty,
(SELECT MAX(NAME) FROM STORE WHERE NO=PUR1.STRA) STRANAME,
(SELECT MAX(NAME) FROM STORE WHERE NO=PUR1.STRB) STRBNAME,
PUR1.STRB
FROM  pur1
WHERE PUR1.INVOICE_CODE=1 AND PUR1.INVOICE_NO>= $P{pfromno} 
AND PUR1.INVOICE_NO<= $P{ptono}  and pur1.location_code= $P{plocation}]]>
	</queryString>
