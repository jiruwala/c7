	<parameter name="pfromno" class="java.lang.String">
		<parameterDescription><![CDATA[FROM NO]]></parameterDescription>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="ptono" class="java.lang.String">
		<parameterDescription><![CDATA[TO NO]]></parameterDescription>
		<defaultValueExpression><![CDATA[99999]]></defaultValueExpression>
	</parameter>
	<parameter name="plocation" class="java.lang.String"/>
	<parameter name="vouType" class="java.lang.String"/>
	<parameter name="pac" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ALL pur1.keyfld,PUR1.ord_no INVOICE_NO, PUR1.ord_date INVOICE_DATE,
PUR1.ord_empno SLSMN,pur1.ord_shpdt duedate,PUR1.remarks memo,pur1.ord_ref c_cus_no,pur1.reference reference_information,
PUR1.ord_ref INV_REF, PUR1.ord_refnm INV_REFNM, PUR1.STRA, PUR1.ord_discamt DISC_AMT,ord_type TYPE,pur1.ord_branchno c_branch_no,
pur1.ord_amt inv_amt ,0 add_amt,(pur1.ord_amt)-pur1.ord_discamt net_amt,
( 
    select max(descr) from invoicetype where location_code=pur1.location_code and no=pur1.ord_type
) type_descr,
(
  select b_name
  from cbranch where code=pur1.ord_ref and brno=pur1.ord_branchno) addr
,F_WORDS(((select nvl(sum(ord_price*(ord_allqty/ord_pack)),0) from pord2 where pord2.keyfld=pur1.keyfld))-pur1.ord_discamt) WRDS,
(select nvl(sum(ord_price*(ord_allqty/ord_pack)),0) from pord2 where pord2.keyfld=pur1.keyfld) inv_amt2,
(select max(name) from salesp where no=pur1.ord_empno) sls_name,
pur1.location_code,
(select name from locations where code=pur1.location_code) location_name,
(select name from store where no=pur1.stra) straname
FROM pord1 pur1
WHERE PUR1.ord_code=601
 AND
((PUR1.ord_no>= $P{pfromno} 
AND PUR1.ord_no<= $P{ptono}  and pur1.location_code= $P{plocation} and pur1.ord_type=$P{vouType})
or (pur1.keyfld=$P{pac})
)
order by pur1.location_code,pur1.ord_no]]>
	</queryString>
