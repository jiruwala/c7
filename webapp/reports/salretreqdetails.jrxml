	<queryString>
		<![CDATA[SELECT PUR2.REFER, PUR2.TYPE,INVOICE_NO,pur2.itempos,
(select descra from items where reference=pur2.refer) descra,
pur2.DESCR, PUR2.PACKD, pur2.unitd,(PUR2.ALLQTY) allqty, PUR2.PRICE, PUR2.DISC_AMT DISC_AMT2,PUR2.PACK,
((PUR2.PRICE-pur2.disc_amt)*PUR2.ALLQTY/PUR2.PACK) AMOUNT,(ALLQTY/PUR2.PACK) PKX
FROM pur2
WHERE PUR2.INVOICE_CODE=12
 and pur2.keyfld=$P{KEYFLD}
ORDER BY PUR2.itempos]]>
	</queryString>
